[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/jumpyvi/elementary-atomic-os/releases/latest/download
MatchPattern=elementary_@v.usr-%a-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=elementary_@v_verity
MatchPartitionType=usr-verity
PartitionFlags=0
ReadOnly=1