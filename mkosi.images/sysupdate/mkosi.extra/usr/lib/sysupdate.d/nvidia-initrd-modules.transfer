[Transfer]
ProtectVersion=%A
Features=nvidia-driver
Verify=no

[Source]
Type=url-file
Path=https://github.com/jumpyvi/elementary-atomic-os/releases/latest/download/
MatchPattern=ext-nvidia-modules-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/EFI/Linux/
PathRelativeTo=boot
MatchPattern=elementary_@v_%a.efi.extra.d/nvidia-modules.raw
Mode=0444
InstancesMax=2