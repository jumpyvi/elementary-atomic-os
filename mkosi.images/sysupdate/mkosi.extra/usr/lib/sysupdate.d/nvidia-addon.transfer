[Transfer]
ProtectVersion=%A
Features=nvidia-driver
Verify=no

[Source]
Type=url-file
Path=https://github.com/jumpyvi/elementary-atomic-os/releases/latest/download/
MatchPattern=ext-nvidia-addon-%a_@v.addon.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=elementary_@v_%a.efi.extra.d/nvidia.addon.efi
Mode=0444
InstancesMax=2