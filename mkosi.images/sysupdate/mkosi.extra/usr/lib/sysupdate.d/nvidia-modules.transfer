[Transfer]
ProtectVersion=%A
Features=nvidia-driver
Verify=no

[Source]
Type=url-file
Path=https://github.com/jumpyvi/elementary-atomic-os/releases/latest/download/
MatchPattern=ext-nvidia-modules-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/extensions/
MatchPattern=ext-nvidia-modules-@a_@v.raw
InstancesMax=2
