[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/jumpyvi/elementary-atomic-os/releases/latest/download
MatchPattern=elementary_@v.usr-%a-verity-sig.@u.raw

[Target]
Type=partition
Path=auto
MatchPattern=elementary_@v_verity_sig
MatchPartitionType=usr-verity-sig
PartitionFlags=0
ReadOnly=1